OPENROUTER_API_KEY=
TAVILY_API_KEY=
NCBI_EMAIL=
NCBI_API_KEY=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Recommended defaults (see hackathon plan): planner/report use a fast
# structured model, analysis/contradiction/insights use a stronger
# reasoning model. Any OpenRouter model ID works here.
PLANNER_MODEL=mistralai/mistral-small-24b-instruct-2501
ANALYSIS_MODEL=deepseek/deepseek-chat
REPORT_MODEL=mistralai/mistral-small-24b-instruct-2501

# Optional per-role overrides. If unset, these roles fall back to
# ANALYSIS_MODEL (contradiction/insights) or PLANNER_MODEL (validator).
# CONTRADICTION_MODEL=
# INSIGHTS_MODEL=
# VALIDATOR_MODEL=

# Optional. If the primary model for a role keeps failing after retries,
# one more attempt is made against this model before giving up (Phase 21).
# FALLBACK_MODEL=mistralai/mistral-7b-instruct

EMBEDDING_PROVIDER=local

# Optional. Where the LanceDB hybrid evidence store lives on disk.
# LANCEDB_PATH=data/lancedb
